# Stripe Configuration
# Get your test keys from https://dashboard.stripe.com/test/apikeys
# For development without Stripe, set USE_MOCK_STRIPE=true
USE_MOCK_STRIPE=false
VITE_USE_MOCK_STRIPE=false
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Email Configuration (for order confirmation emails)
# If not configured, order emails will be logged to console instead of sent
EMAIL_MODE=production
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-password
EMAIL_FROM=Lavirant <noreply@lavirant.pl>

# Webhook verification
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Invoice configuration
INVOICE_SELLER_NAME=Lavirant Sp. z o.o.
INVOICE_SELLER_ADDRESS=ul. Przykladowa 1, 00-001 Warszawa
INVOICE_SELLER_NIP=1234567890
INVOICE_SELLER_EMAIL=zamowienia@lavirant.pl
INVOICE_SELLER_FIRST_NAME=Jan
INVOICE_SELLER_LAST_NAME=Kowalski
INVOICE_SELLER_PHONE=+48123456789
INVOICE_SELLER_STREET=ul. Przykladowa
INVOICE_SELLER_BUILDING=1
INVOICE_SELLER_CITY=Warszawa
INVOICE_SELLER_POST_CODE=00-001
INVOICE_STORAGE_DIR=storage/invoices

# Payment status job (optional)
PAYMENT_STATUS_JOB_INTERVAL_MINUTES=5
PAYMENT_PENDING_THRESHOLD_MINUTES=30
PAYMENT_STATUS_JOB_DRY_RUN=false

# InPost Shipping Configuration
INPOST_API_SHIPX=your-shipx-api-token
INPOST_GEOWIDGET=your-geowidget-token
INPOST_SHIPX_ORG_ID=your-organization-id
