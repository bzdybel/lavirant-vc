# Node Environment
NODE_ENV=development

# Server Configuration
PORT=5173
HOST=0.0.0.0
BASE_URL=https://lavirant.pl

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Email Configuration (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-password
EMAIL_FROM=noreply@lavirant.pl
EMAIL_SECURE=false

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
USE_MOCK_STRIPE=false

# Payment Webhook Configuration
PAYMENT_WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_MANUAL_ONLY=false

# InPost Shipping Configuration
INPOST_API_SHIPX=your-shipx-api-token
INPOST_SHIPX_ORG_ID=your-organization-id
INPOST_SHIPX_ENV=sandbox
INPOST_GEOWIDGET=your-geowidget-token
INPOST_GEOWIDGET_NGROK=your-ngrok-geowidget-token
INPOST_SERVICE_LOCKER=inpost_locker_standard
INPOST_SERVICE_COURIER=inpost_courier_standard
INPOST_PARCEL_TEMPLATE=small
INPOST_PARCEL_LENGTH_MM=80
INPOST_PARCEL_WIDTH_MM=360
INPOST_PARCEL_HEIGHT_MM=640
INPOST_PARCEL_WEIGHT_KG=2
MOCK_INPOST=false
SHIPPING_PROVIDER=INPOST

# Background Jobs Configuration
PAYMENT_STATUS_JOB_INTERVAL_MINUTES=5
PAYMENT_PENDING_THRESHOLD_MINUTES=30
PAYMENT_STATUS_JOB_DRY_RUN=false
SHIPX_POLLING_JOB_INTERVAL_MINUTES=15

# Invoice Configuration
INVOICE_STORAGE_DIR=./storage/invoices
INVOICE_SELLER_NAME=Lavirant
INVOICE_SELLER_FIRST_NAME=Jan
INVOICE_SELLER_LAST_NAME=Kowalski
INVOICE_SELLER_EMAIL=zamowienia@lavirant.pl
INVOICE_SELLER_PHONE=+48123456789
INVOICE_SELLER_STREET=ul. Przykładowa
INVOICE_SELLER_BUILDING=123
INVOICE_SELLER_CITY=Warszawa
INVOICE_SELLER_POST_CODE=00-001
INVOICE_SELLER_ADDRESS=ul. Przykładowa 123, 00-001 Warszawa
INVOICE_SELLER_NIP=1234567890

# Optional: Encrypted Secrets Configuration (for production)
# SECRETS_PATH=/path/to/secrets.enc
# DECRYPTION_KEY=hex-encoded-key
